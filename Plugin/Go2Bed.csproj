<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <TargetExt>.rhp</TargetExt>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Title>Go2Bed</Title>
    <Version>1.1.0</Version>
    <AssemblyTitle>Go2Bed</AssemblyTitle>
    <Product>Go2Bed</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Grasshopper/Go2Bed.Grasshopper.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Core/Go2Bed.Core.csproj" />
    <PackageReference Include="Clipper2" Version="2.0.0" GeneratePathProperty="true" />
    <PackageReference Include="RhinoCommon" Version="8.21.25188.17001" ExcludeAssets="runtime" />
    <None Update="Go2Bed.rui" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../brand/icons/go2bed.ico" LogicalName="Go2Bed.Icon.ico" />
    <Compile Remove="ToBedDEBUG.cs" Condition="'$(Configuration)' != 'Debug'" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <None Include="../Barn_original_with_simplified_interior.3dm" Link="Barn_original_with_simplified_interior.3dm" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyGrasshopperForRider" AfterTargets="Build">
    <Copy SourceFiles="../Grasshopper/bin/$(Configuration)/$(TargetFramework)/Go2Bed.Grasshopper.gha" DestinationFolder="$(TargetDir)" />
  </Target>
  <Target Name="PackageMac" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageRoot>$(IntermediateOutputPath)go2bed-mac-package</PackageRoot>
      <Bundle>$(PackageRoot)/Go2Bed.rhp</Bundle>
    </PropertyGroup>
    <MakeDir Directories="$(Bundle);$(MSBuildProjectDirectory)/../dist"/>
    <Copy SourceFiles="$(TargetPath);$(TargetDir)Go2Bed.rui;$(TargetDir)Go2Bed.Core.dll;$(TargetDir)Clipper2Lib.dll;$(PkgClipper2)/License.txt" DestinationFolder="$(Bundle)"/>
    <ZipDirectory SourceDirectory="$(PackageRoot)" DestinationFile="$(MSBuildProjectDirectory)/../dist/Go2Bed.macrhi" Overwrite="true"/>
  </Target>
  <!-- Builds the Yak package: dotnet build Plugin/Go2Bed.csproj -c Release -t:Yak -->
  <Target Name="Yak" DependsOnTargets="Build">
    <Error Condition="'$(Configuration)' != 'Release'" Text="Build the Yak package with -c Release." />
    <PropertyGroup>
      <YakExe Condition="'$(YakExe)' == ''">/Applications/Rhino 8.app/Contents/Resources/bin/yak</YakExe>
      <YakDist Condition="'$(YakDist)' == ''">$(MSBuildProjectDirectory)/../dist</YakDist>
      <YakStage>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)yak</YakStage>
    </PropertyGroup>
    <RemoveDir Directories="$(YakStage)" />
    <MakeDir Directories="$(YakStage);$(YakDist)" />
    <Copy SourceFiles="$(TargetDir)Go2Bed.rhp;$(TargetDir)Go2Bed.rui;$(TargetDir)Go2Bed.Grasshopper.gha;$(TargetDir)Go2Bed.Core.dll;$(TargetDir)Clipper2Lib.dll;$(MSBuildProjectDirectory)/../packaging/manifest.yml" DestinationFolder="$(YakStage)" />
    <Copy SourceFiles="$(PkgClipper2)/License.txt" DestinationFiles="$(YakStage)/Clipper2-LICENSE.txt" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../brand/go2bed.png" DestinationFiles="$(YakStage)/icon.png" />
    <Exec Command="&quot;$(YakExe)&quot; build --platform mac" WorkingDirectory="$(YakStage)" />
    <ItemGroup><YakPackage Include="$(YakStage)/*.yak" /></ItemGroup>
    <Copy SourceFiles="@(YakPackage)" DestinationFolder="$(YakDist)" />
  </Target>
</Project>
