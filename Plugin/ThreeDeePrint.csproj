<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <TargetExt>.rhp</TargetExt>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>1.0.0</Version>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Clipper2" Version="2.0.0" GeneratePathProperty="true" />
    <PackageReference Include="RhinoCommon" Version="8.21.25188.17001" ExcludeAssets="runtime" />
    <EmbeddedResource Include="Profiles/MK4S.config" LogicalName="ThreeDeePrint.MK4S.config" />
    <None Update="Native/libThreeDeeSolid.dylib;Native/Manifold-LICENSE.txt;Native/Manifold-AUTHORS.txt" TargetPath="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Properties/RiderPreview.py" TargetPath="RiderPreview.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Barn_original_with_simplified_interior.3dm" Link="Barn_original_with_simplified_interior.3dm" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PackageMac" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageRoot>$(IntermediateOutputPath)mac-package</PackageRoot>
      <Bundle>$(PackageRoot)/ThreeDeePrint.rhp</Bundle>
    </PropertyGroup>
    <MakeDir Directories="$(Bundle);$(MSBuildProjectDirectory)/../dist"/>
    <Copy SourceFiles="$(TargetPath);$(TargetDir)Clipper2Lib.dll;$(TargetDir)libThreeDeeSolid.dylib;$(TargetDir)Manifold-LICENSE.txt;$(TargetDir)Manifold-AUTHORS.txt;$(PkgClipper2)/License.txt" DestinationFolder="$(Bundle)"/>
    <ZipDirectory SourceDirectory="$(PackageRoot)" DestinationFile="$(MSBuildProjectDirectory)/../dist/ThreeDeePrint.macrhi" Overwrite="true"/>
  </Target>
</Project>
